apiVersion: v1
kind: Config
clusters:
- name: mocha
  cluster:
    server: https://5.196.80.72:6443
    certificate-authority-data: 
contexts:
- name: mocha
  context:
    cluster: mocha
    namespace: default
    user: mocha-oidc
current-context: mocha
users:
- name: mocha-oidc
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: kubectl
      args:
      - oidc-login
      - get-token
      - --oidc-issuer-url=https://authentik.mocha.thoughtless.eu/application/o/mocha-oidc/
      - --oidc-client-id=mocha-oidc
      - --oidc-extra-scope=email
      - --oidc-extra-scope=profile
      env: null
      provideClusterInfo: false
