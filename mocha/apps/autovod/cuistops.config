#!/bin/bash
# shellcheck disable=SC2034
set -a

STREAM_SOURCE="twitch"
UPLOAD_SERVICE="youtube"

API_CALLS="false"
API_URL=""

STREAMER_TITLE="initial_title"
STREAMER_GAME="inital_game"

STREAMLINK_QUALITY="best"
STREAMLINK_LOGS="info"

# streamlink 7.x dropped --twitch-disable-reruns/-hosting and always strips ads.
# An account token only helps to get an ad-free source in the first place.
STREAMLINK_FLAGS=()
if [[ -n "${TWITCH_OAUTH_TOKEN:-}" ]]; then
	STREAMLINK_FLAGS+=("--twitch-api-header=Authorization=OAuth ${TWITCH_OAUTH_TOKEN}")
fi

VIDEO_DURATION="11:45:00"
SPLIT_INTO_PARTS="false"
SPLIT_VIDEO_DURATION="06:00:00"
SAVE_ON_FAIL="false"

VIDEO_TITLE="$STREAMER_NAME - TIME_DATE"
VIDEO_DESCRIPTION="Rediffusion du live https://twitch.tv/$STREAMER_NAME du TIME_DATE."
VIDEO_VISIBILITY="private"
VIDEO_PLAYLIST="Lives Twitch"

set +a
