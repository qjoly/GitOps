# Every private hostname is served by traefik-internal (ClusterIP pinned in mocha/system/traefik-internal).
# Americano's NetBird IP: these apps are served by Americano's own traefik on
# https://<name>.nb.mocha.thoughtless.eu (not via traefik-internal). A dedicated
# server block because the template plugin below runs before hosts.
# Update the IP if the Americano peer re-registers.
agregar.nb.mocha.thoughtless.eu sonarr.nb.mocha.thoughtless.eu radarr.nb.mocha.thoughtless.eu:53 {
    bind 127.0.0.1
    hosts {
        100.92.156.232 agregar.nb.mocha.thoughtless.eu sonarr.nb.mocha.thoughtless.eu radarr.nb.mocha.thoughtless.eu
    }
    template IN AAAA {
        rcode NOERROR
    }
}

nb.mocha.thoughtless.eu:53 {
    bind 127.0.0.1
    template IN A {
        answer "{{ .Name }} 60 IN A 10.96.208.53"
    }
    template IN AAAA {
        rcode NOERROR
    }
}
.:53 {
    bind 127.0.0.1
    forward . 10.96.0.10
    cache 30
}
