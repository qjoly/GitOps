# Every private hostname is served by traefik-internal (ClusterIP pinned in mocha/system/traefik-internal).
nb.mocha.thoughtless.eu:53 {
    bind 127.0.0.1
    hosts {
        # Americano's NetBird IP: agregarr is served by Americano's own traefik
        # on https://agregar.nb.mocha.thoughtless.eu (not via traefik-internal).
        # Update this if the Americano peer re-registers with a new IP.
        100.92.156.232 agregar.nb.mocha.thoughtless.eu
        fallthrough
    }
    template IN A {
        answer "{{ .Name }} 60 IN A 10.96.208.53"
    }
    template IN AAAA {
        rcode NOERROR
    }
}
.:53 {
    bind 127.0.0.1
    forward . 10.96.0.10
    cache 30
}
