# NetBird peer for Americano. Joins the self-hosted management server
# (netbird.mocha.thoughtless.eu) with a one-shot setup key, then stays
# connected so other peers can reach this host on its NetBird IP (100.64.0.0/10).
# App ports exposed this way must be allow-listed in /etc/nftables-americano.nft
# on the host: publish them on 0.0.0.0 and let that table drop non-NetBird sources.
[Unit]
Description=NetBird peer
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/netbirdio/netbird:latest
ContainerName=netbird
HostName=Americano
Network=host
# WireGuard + TUN need NET_ADMIN; the daemon also creates a raw socket
# (NET_RAW) and asks for SYS_ADMIN/SYS_RESOURCE.
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddCapability=SYS_ADMIN
AddCapability=SYS_RESOURCE
Volume=/data/apps/netbird:/etc/netbird
Environment=NB_MANAGEMENT_URL=https://netbird.mocha.thoughtless.eu
# The setup key lives in the podman secret "netbird-americano", created once on
# the host from kv/netbird americano_setup_key. Never commit the key itself.
Secret=netbird-americano,type=env,target=NB_SETUP_KEY
Exec=up --hostname Americano

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
