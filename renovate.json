{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignorePaths": [
    "archives/**",
    "common/argocd/**",
    "mocha/apps/trmnl-server/**"
  ],
  "packageRules": [
    {
      "description": "Immich Postgres: block major bumps, PG major upgrade needs a manual dump/restore (vector extensions)",
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "helm CLI: stay on 3.x, helm 4 breaks helmfile v0.171.0 and the helm-diff plugin install",
      "matchDepNames": [
        "helm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Group the Virtink stack (operator + CAPI providers) into a single PR, kept CAPI-compatible together",
      "matchFileNames": [
        "mocha/system/virtink/**",
        "mocha/system/capi-provider-virtink/**",
        "mocha/system/capi-cp-kamaji/**"
      ],
      "groupName": "virtink stack"
    },
    {
      "description": "Virtink/Kamaji CAPI providers: block automatic majors. A major bump usually changes the served CRD apiVersions and requires manual edits in mocha/system/* and apps/kube-lab.",
      "matchPackageNames": [
        "smartxworks/cluster-api-provider-virtink",
        "clastix/cluster-api-control-plane-provider-kamaji",
        "smartxworks/virtink"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update docker image references",
      "managerFilePatterns": [
        "/\\.yaml$/",
        "/\\.yml$/"
      ],
      "matchStrings": [
        "image: (?<depName>.*?):(?<currentValue>.*?)\\s+"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Virtink operator pinned in its kustomize remote release-asset URL",
      "managerFilePatterns": [
        "/mocha/system/virtink/manifests/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "github\\.com/(?<depName>smartxworks/virtink)/releases/download/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
