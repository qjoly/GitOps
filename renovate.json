{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignorePaths": [
    "archives/**",
    "common/argocd/**",
    "mocha/apps/trmnl-server/**"
  ],
  "packageRules": [
    {
      "description": "Immich Postgres: block major bumps, PG major upgrade needs a manual dump/restore (vector extensions)",
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "helm CLI: stay on 3.x, helm 4 breaks helmfile v0.171.0 and the helm-diff plugin install",
      "matchDepNames": [
        "helm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Group the ProxyAuthK8S chart with its CRD chart: the controller refuses to start against CRDs older than the app (checks spec.upstream_auth), and both publish the same versions",
      "matchPackageNames": [
        "ghcr.io/batleforc/proxyauthk8s/chart",
        "ghcr.io/batleforc/proxyauthk8s/chart-crd"
      ],
      "groupName": "proxyauthk8s"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update docker image references",
      "managerFilePatterns": [
        "/\\.yaml$/",
        "/\\.yml$/"
      ],
      "matchStrings": [
        "image: (?<depName>.*?):(?<currentValue>.*?)\\s+"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Corium node documents: Helm add-ons pinned under addons[] (no manager understands this shape)",
      "managerFilePatterns": [
        "/doppio/corium/.*\\.yaml$/"
      ],
      "matchStrings": [
        "chart: [^/\\s]+/(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)\\s+namespace: \\S+\\s+repository:\\s+name: \\S+\\s+url: (?<registryUrl>\\S+)"
      ],
      "datasourceTemplate": "helm"
    }
  ]
}
